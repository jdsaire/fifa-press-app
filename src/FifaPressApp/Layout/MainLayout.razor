@inherits LayoutComponentBase
<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @* main holds only the content column. The theme control used to sit in a
           strip above it; it is now a row in the nav list, where it survives the
           breakpoint collapse without any layout of its own. *@
        <article class="content px-4" id="main-content" tabindex="-1">
            @Body
        </article>
    </main>
</div>

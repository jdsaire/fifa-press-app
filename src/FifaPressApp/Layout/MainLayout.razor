@inherits LayoutComponentBase
<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @* A strip of its own, above the content column, holding only the theme
           control. Present at every breakpoint, right-aligned at both, and
           independent of the sidebar header — see MainLayout.razor.css. *@
        <div class="theme-strip">
            <ThemeTrigger />
        </div>

        <article class="content px-4" id="main-content" tabindex="-1">
            @Body
        </article>
    </main>
</div>

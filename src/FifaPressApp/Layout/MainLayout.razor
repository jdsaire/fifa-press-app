@inherits LayoutComponentBase
@implements IDisposable
@inject LocaleService L

@* Everything is inside the locale cascade, including the sidebar — the nav
   labels are as localized as the page body, and a switch that re-rendered only
   the content column would leave half the screen in the previous language. *@
<LocaleProvider>
@* The one string outside the cascade, because this component is the
   cascade's parent and cannot receive its own value. It reads the service
   directly and subscribes for the re-render — the exception that proves
   the rule, and the only place in the app allowed to do it. *@
<a href="#main-content" class="skip-link">@L[L.Current, "nav.skipToContent"]</a>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @* A persistent row above the content column, and the content column.
           The row carries who is signed in — the one question every screen has
           to answer without being asked, and the one the sidebar could not
           answer on a phone, because the sidebar collapses there and this does
           not. It is not the theme strip this element once held: that strip was
           deleted rather than repurposed, and nothing about appearance lives
           here. *@
        <div class="top-row px-4">
            <SessionBar />
        </div>
        <article class="content px-4" id="main-content" tabindex="-1">
            @Body
        </article>
    </main>
</div>
</LocaleProvider>

@code {
    protected override void OnInitialized() => L.OnChanged += Refresh;

    public void Dispose() => L.OnChanged -= Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);
}

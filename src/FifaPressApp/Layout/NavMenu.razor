@implements IDisposable
@inject SimulatedSessionProvider Session
@inject LocaleService L
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @* The product name, never translated: 11 §3's rule is that a name
           identifying the product stays English, while a name identifying what
           a person is looking at translates. *@
        <a class="navbar-brand" href="">@L[Locale, "app.name"]</a>
        <button title="@MenuTitle" class="navbar-toggler" @onclick="ToggleNavMenu"
                aria-expanded="@(!collapseNavMenu)" aria-controls="nav-menu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div id="nav-menu" class="@NavMenuCssClass nav-scrollable">
    @if (Session.Current is DemoAccount holder)
    {
        @* Above the rows, and read-only. With two demo records whose whole
           point is comparison, "which one am I looking at" is a question the
           interface has to answer without being asked — and on every screen
           except the record itself, nothing else on the page says. It is not a
           menu and has no affordance beyond being read. *@
        <div class="nav-session">
            <span class="nav-session__label">@L[Locale, "nav.signedInAs"]</span>
            <span class="nav-session__holder">@holder.HolderName</span>
            <span class="nav-session__credential">@holder.CredentialId</span>
        </div>
    }

    @* Three destinations, then the controls. Sign in is not among the
       destinations — it is a door, not a section. It used to be true that it
       gated nothing; it gates the record now, and the row order says so by
       keeping the destinations contiguous at the top and grouping the two
       state-not-destination controls at the bottom. *@
    <nav class="nav flex-column">
        @* href="record", and no Match override. The empty href this row used to
           carry needed Match="NavLinkMatch.All" only because an empty prefix
           matches every address in the app; a real path gets a correct active
           state from ordinary prefix matching. *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="record">
                @L[Locale, "nav.record"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="matches">
                @L[Locale, "nav.matches"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="help">
                @L[Locale, "nav.help"]
            </NavLink>
        </div>
        @* A fourth row. It is a control rather than a destination: it has no
           href, so it is not a NavLink and no active state can ever apply to
           it. It is in the list rather than above the content column because
           this list is already the same element at both breakpoints — a row
           added to it collapses on a phone for free. *@
        <div class="nav-item px-3">
            <ThemeTrigger />
        </div>
        @if (Session.IsSignedIn)
        {
            @* Fifth and last, below the theme row. No confirmation dialog:
               there is nothing to lose, and a modal guarding a simulated
               session would be theatre. *@
            <div class="nav-item px-3">
                <button type="button" class="nav-signout" @onclick="SignOut">
                    <span class="nav-signout__icon" aria-hidden="true">⇥</span>
                    <span class="nav-signout__label">@L[Locale, "nav.signOut"]</span>
                </button>
            </div>
        }
    </nav>
</div>

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // Pulled out of the attribute rather than inlined: a lookup with its own
    // quoted key inside a quoted attribute value is a parse the Razor
    // compiler should not have to be trusted with.
    private string MenuTitle => L[Locale, "nav.menu"];

    protected override void OnInitialized() => Session.OnChanged += Refresh;

    public void Dispose() => Session.OnChanged -= Refresh;

    /// <summary>
    /// The session changes from the sign-in screen, which is not this
    /// component's child and cannot tell it directly. Subscribing is what keeps
    /// the indicator and the sign-out row from being a render behind.
    /// </summary>
    private void Refresh() => InvokeAsync(StateHasChanged);

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void SignOut()
    {
        Session.SignOut();

        // Back to the public landing, which is where a person with no session
        // belongs — and it announces that the sign-out happened rather than
        // leaving them to infer it from a changed sidebar.
        Navigation.NavigateTo("");
    }
}

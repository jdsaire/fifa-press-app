<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FIFA Press App</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu"
                aria-expanded="@(!collapseNavMenu)" aria-controls="nav-menu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div id="nav-menu" class="@NavMenuCssClass nav-scrollable">
    @* Three top-level destinations, in this order. Sign in is deliberately not
       among them: it is a door, not a section, and it gates nothing. *@
    <nav class="nav flex-column">
        @* href="record", and no Match override. The empty href this row used to
           carry needed Match="NavLinkMatch.All" only because an empty prefix
           matches every address in the app; a real path gets a correct active
           state from ordinary prefix matching. *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="record">
                My Access
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="matches">
                Matches
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="help">
                Help
            </NavLink>
        </div>
        @* A fourth row, and the last one, so it inherits the bottom padding the
           list already gives its final item. It is a control rather than a
           destination: it has no href, so it is not a NavLink and no active
           state can ever apply to it. It is in the list rather than above the
           content column because this list is already the same element at both
           breakpoints — a row added to it collapses on a phone for free. *@
        <div class="nav-item px-3">
            <ThemeTrigger />
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

@* Marks a change that has NOT happened yet, so a conditional entry is never
   read as a decision already taken. The wording is deliberately "may" and
   "depends on" rather than anything that sounds settled — a foreseeable change
   is conditional precisely because its condition is unresolved, and copy that
   drifts into sounding like a commitment turns a warning into a promise the
   service cannot keep. *@

@inject LocaleService L

<span class="foreseeable-badge">
    <span class="foreseeable-badge__mark" aria-hidden="true">•</span>
    @Text
</span>

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }

    /// <summary>
    /// An override, for a caller with something more specific to say. It
    /// defaults to null rather than to an English sentence: a literal default on
    /// a [Parameter] is assigned once at construction and never re-evaluated,
    /// which is exactly the stale-string bug 11 §5.2 names — the badge would
    /// keep the language the app was in when it was first rendered.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    private string Text => Label ?? L[Locale, "foreseeable.label"];
}

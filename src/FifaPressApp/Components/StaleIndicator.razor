@inject LocaleService L

@* Staleness is a property of every surface that reads cached data, not a
   state that one screen enters when something goes wrong. So this renders
   ALWAYS — including when the data is seconds old — because an indicator that
   only appears when there is a problem teaches people to read its absence as
   "fine", and absence is exactly what a broken sync looks like too. *@

<p class="stale-indicator @(IsStale ? "stale-indicator--old" : null)" role="status">
    <span class="stale-indicator__label">@AgeSentence</span>
    @if (ShowExactTimestamp)
    {
        <span class="stale-indicator__stamp">
            (<time datetime="@LastSyncedUtc.ToString("o")">@L.Date(Locale, LastSyncedUtc, "dayShortMonthTime")</time> UTC)
        </span>
    }
</p>

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }

    /// <summary>When the data being shown was last synchronised.</summary>
    [Parameter]
    public DateTime LastSyncedUtc { get; set; }

    /// <summary>
    /// The moment to measure against. Passed in rather than read from the
    /// clock so this component shows the same age the rest of the app is
    /// working from.
    /// </summary>
    [Parameter]
    public DateTime AsOfUtc { get; set; }

    /// <summary>
    /// The resource key naming what the age applies to, e.g.
    /// <c>record.staleSubject</c>.
    ///
    /// <para>
    /// A key rather than a sentence, and that is a fix rather than a
    /// preference. This was a <c>string</c> with an English literal default,
    /// and callers passed English literals into it — a <c>[Parameter]</c>
    /// default is assigned once at construction and never re-evaluated, so the
    /// subject kept whichever language the app was in when the component was
    /// first rendered. It is one of the three places <c>11_I18N.md</c> §5.2's
    /// stale-string bug genuinely occurred.
    /// </para>
    /// </summary>
    [Parameter]
    public string SubjectKey { get; set; } = "stale.defaultSubject";

    [Parameter]
    public bool ShowExactTimestamp { get; set; } = true;

    /// <summary>
    /// Past this, the indicator changes its wording and its colour. Below it,
    /// it still renders — just quietly.
    /// </summary>
    [Parameter]
    public TimeSpan StaleAfter { get; set; } = TimeSpan.FromHours(1);

    private TimeSpan Age => AsOfUtc - LastSyncedUtc;

    private bool IsStale => Age >= StaleAfter;

    private string Subject => L[Locale, SubjectKey];

    /// <summary>
    /// Written out as an age rather than as a word like "stale", partly because
    /// a number is harder to skim past, and partly because "stale" has no
    /// single-word equivalent in the other two languages this service has to
    /// work in — both translate it as something closer to "spoiled".
    ///
    /// <para>
    /// The one/many split is carried in the resources rather than done here
    /// with an "s". Spanish and Portuguese do not pluralize by appending a
    /// letter, and a sentence assembled from a number plus a suffix produces
    /// grammatically wrong output in both.
    /// </para>
    /// </summary>
    private string AgeSentence
    {
        get
        {
            var age = Age;

            if (age < TimeSpan.Zero)
            {
                return L.Format(Locale, "stale.future", ("subject", Subject));
            }

            var howLong = age.TotalMinutes switch
            {
                < 1 => L[Locale, "stale.lessThanAMinute"],
                < 2 => L[Locale, "stale.oneMinute"],
                < 60 => L.Format(Locale, "stale.minutes", ("count", (int)age.TotalMinutes)),
                < 120 => L[Locale, "stale.oneHour"],
                < 1440 => L.Format(Locale, "stale.hours", ("count", (int)age.TotalHours)),
                < 2880 => L[Locale, "stale.oneDay"],
                _ => L.Format(Locale, "stale.days", ("count", (int)age.TotalDays)),
            };

            return IsStale
                ? L.Format(Locale, "stale.lastUpdatedStale",
                    ("howLong", howLong), ("subject", Capitalise(Subject)))
                : L.Format(Locale, "stale.lastUpdated", ("howLong", howLong));
        }
    }

    private static string Capitalise(string value) =>
        value.Length == 0 ? value : char.ToUpperInvariant(value[0]) + value[1..];
}

@* A small named set of inline SVG glyphs.
   ------------------------------------------------------------------------
   Drawn in this repository rather than pulled from anywhere. No icon font, no
   icon package, no CDN: the app's dependency list is unchanged by this file,
   and the shapes below are plain geometry that nobody else owns.

   EVERY ICON HERE IS DECORATIVE, AND THAT IS A RULE RATHER THAN A DEFAULT.
   Each one sits beside text that already says what it means — a date icon next
   to the date, a location icon next to the venue. So each is hidden from
   assistive technology (`aria-hidden`) and taken out of the tab order
   (`focusable`, which Internet Explorer-era SVG otherwise makes focusable). A
   screen reader hears the text and nothing extra; nothing on screen loses its
   words to make room for a picture.

   Colour is inherited, never declared. `currentColor` means each glyph takes
   whatever colour the text around it already has, so both themes are served by
   the tokens already in `app.css` and this file introduces no colour of its own
   — which is what keeps it out of the design work that is still to come. *@

@if (Draw is not null)
{
    <svg class="icon"
         viewBox="0 0 16 16"
         width="16"
         height="16"
         fill="none"
         stroke="currentColor"
         stroke-width="1.5"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true"
         focusable="false">
        @Draw
    </svg>
}

@code {
    /// <summary>
    /// Which glyph to draw: <c>date</c>, <c>location</c> or <c>phase</c> on the
    /// match surfaces, and <c>home</c>, <c>matches</c>, <c>record</c>,
    /// <c>help</c> or <c>settings</c> beside a navigation label.
    /// </summary>
    [Parameter]
    public string Name { get; set; } = string.Empty;

    // An unknown name draws nothing at all rather than throwing. A missing
    // decoration is not worth taking a screen down for, and the text the icon
    // would have sat beside is still there and still says the same thing.
    private RenderFragment? Draw => Name?.ToLowerInvariant() switch
    {
        // A calendar: a page with a bound across the top and two hangers.
        "date" => @<g>
            <rect x="2" y="3.25" width="12" height="10.5" rx="1.5" />
            <path d="M2 6.75h12" />
            <path d="M5.5 1.75v2.5" />
            <path d="M10.5 1.75v2.5" />
        </g>,

        // A map pin: a teardrop over a hollow centre.
        "location" => @<g>
            <path d="M8 14.25s4.75-4.15 4.75-7.75a4.75 4.75 0 1 0-9.5 0c0 3.6 4.75 7.75 4.75 7.75Z" />
            <circle cx="8" cy="6.5" r="1.75" />
        </g>,

        // A bracket: two rounds feeding one, which is what a phase is.
        "phase" => @<g>
            <path d="M2.25 3.5h3.5v9h-3.5" />
            <path d="M5.75 8h4" />
            <path d="M9.75 5.25v5.5" />
            <path d="M9.75 8h4" />
        </g>,

        // The five navigation glyphs. Each sits beside a nav label that already
        // says the word, so the decorative rule above applies to them exactly
        // as it does to the three match glyphs: same viewBox, same stroke, same
        // currentColor, nothing announced to assistive technology.

        // A house: a roof over a body.
        "home" => @<g>
            <path d="M2.25 7.25 8 2.5l5.75 4.75" />
            <path d="M3.75 6.5v7h8.5v-7" />
        </g>,

        // A football: a ball with a centre panel and its seams.
        "matches" => @<g>
            <circle cx="8" cy="8" r="5.75" />
            <path d="M8 4.6 5.4 6.5l1 3.05h3.2l1-3.05Z" />
            <path d="M8 2.25v2.35M3.15 6.2l2.25 .3M4.55 11.6l1.85-2.05M11.45 11.6 9.6 9.55M12.85 6.2l-2.25 .3" />
        </g>,

        // A clipboard: a board with a clip and two written lines.
        "record" => @<g>
            <path d="M5.75 3.25h-1.5a1 1 0 0 0-1 1v8.5a1 1 0 0 0 1 1h7.5a1 1 0 0 0 1-1v-8.5a1 1 0 0 0-1-1h-1.5" />
            <rect x="5.75" y="2" width="4.5" height="2.5" rx="0.75" />
            <path d="M6 8h4M6 10.5h2.5" />
        </g>,

        // A question mark inside a circle.
        "help" => @<g>
            <circle cx="8" cy="8" r="5.75" />
            <path d="M6.4 6.4a1.65 1.65 0 1 1 2.2 1.6c-.4.15-.6.5-.6.9v.3" />
            <path d="M8 11.55h.01" />
        </g>,

        // A gear: a hub inside a six-toothed cog.
        //
        // The dossier proposed the teeth as six radial strokes around the hub.
        // Rendered at 16px that reads as a sun rather than a gear — the round
        // caps this file mandates turn a short radial stroke into a ray — and a
        // settings glyph that looks like a brightness control is worse than no
        // glyph in an app whose appearance control is one screen away. The
        // teeth are a closed outline instead: same hub, same attributes, same
        // stroke, one shape that can only be a cog.
        "settings" => @<g>
            <circle cx="8" cy="8" r="2.15" />
            <path d="M7.01 1.73 L8.99 1.73 L9.23 3.41 L11.36 4.64 L12.93 4.00 L13.93 5.72 L12.59 6.77 L12.59 9.23 L13.93 10.28 L12.93 12.00 L11.36 11.36 L9.23 12.59 L8.99 14.27 L7.01 14.27 L6.77 12.59 L4.64 11.36 L3.07 12.00 L2.07 10.28 L3.41 9.23 L3.41 6.77 L2.07 5.72 L3.07 4.00 L4.64 4.64 L6.77 3.41 Z" />
        </g>,

        _ => null,
    };
}

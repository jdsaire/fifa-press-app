@* One change in the record, in two layers.
   ------------------------------------------------------------------------
   Four things are not optional here: what changed, why, what to do next, and
   when. A row missing any of them is malformed rather than merely sparse — the
   whole difference between this app and the situation it replaces is that
   "your access changed" arrives with a reason attached. The model refuses to
   construct without them, so this component can render them unconditionally
   instead of guarding every field.

   THE COLLAPSED LAYER IS STILL FULLY INFORMATIVE, and that is the constraint
   that governs which half each field goes in. Collapsing detail must never mean
   collapsing the fact that something changed: what changed, when it takes
   effect, and whether it is still conditional are all visible without opening
   anything. What the second layer holds is the explanation — the reason, the
   next step, the condition's wording, the value this change replaced — which is
   detail a person standing at a barrier does not need before they need it.

   <details>/<summary> RATHER THAN A BUTTON AND A FLAG. The row itself becomes
   the control, which is what the addendum asks for — an existing row made
   disclosable, not a new control added beside it. It is keyboard-operable, it
   is announced as expandable by a screen reader, and it needs no JavaScript at
   all, which matters on a page that has to work from cache with no network.

   The one conditional block that matters is the superseded value. A change with
   nothing visible to compare against reads as information; shown beside the
   value it replaced, it reads as a change. *@

@inject LocaleService L

<article class="change-row @(IsForeseeable ? "change-row--foreseeable" : null) @(JustArrived ? "change-row--arriving" : null)">
    @if (JustArrived)
    {
        @* The visual confirmation above — the row opening and animating in — has
           no counterpart for a screen reader, which sees the same markup as any
           other row. This is the same aria-live pattern the app's own form
           errors already use (SignIn.razor, RequestAccessForm.razor), applied
           here to a successful write for the first time. *@
        <p class="visually-hidden" role="status" aria-live="polite">@Change.WhatChangedText.For(Locale)</p>
    }
    <details class="change-row__disclosure" open="@JustArrived">
        <summary class="change-row__summary">
            @if (IsForeseeable)
            {
                <ForeseeableBadge />
            }

            @* Resolved from the cascading locale, never from the model's English
               canonical accessor. *@
            <h3 class="change-row__what">@Change.WhatChangedText.For(Locale)</h3>

            <p class="change-row__when">
                <time datetime="@Change.EffectiveUtc.ToString("o")">
                    @L[Locale, IsForeseeable ? "changeRow.takesEffect" : "changeRow.tookEffect"] @L.Date(Locale, Change.EffectiveUtc, "dayMonthYearTime") UTC
                </time>
            </p>

            <span class="change-row__more">@L[Locale, "changeRow.moreLabel"]</span>
        </summary>

        <div class="change-row__detail">
            @if (Superseded is not null)
            {
                @* The replaced value stays visible. It is not deleted, and this is
                   not an audit-trail nicety: a correction that hides what it
                   corrected leaves the reader unable to tell whether anything
                   actually moved. *@
                <div class="change-row__superseded">
                    <p class="change-row__superseded-label">@L[Locale, "changeRow.replacesLabel"]</p>
                    <p class="change-row__superseded-value">@Superseded.WhatChangedText.For(Locale)</p>
                    <p class="change-row__superseded-when">
                        <time datetime="@Superseded.EffectiveUtc.ToString("o")">
                            @L[Locale, "changeRow.recorded"] @L.Date(Locale, Superseded.EffectiveUtc, "dayMonthYearTime") UTC
                        </time>
                    </p>
                </div>
            }

            @if (Change.ConditionTextLocalized is not null)
            {
                <div class="change-row__condition">
                    <p class="change-row__field-label">@L[Locale, "changeRow.conditionLabel"]</p>
                    <p>@Change.ConditionTextLocalized.For(Locale)</p>
                    @if (DependsOnFixture is not null)
                    {
                        @* Named by round, venue and date — never by the teams
                           playing in it. This fixture has not kicked off, so who
                           is in it is something the app is not entitled to know. *@
                        <p class="change-row__dependency">
                            @L.Format(Locale, "changeRow.dependsOn",
                                ("phase", FixtureLabels.Phase(L, Locale, DependsOnFixture)),
                                ("venue", DependsOnFixture.Venue),
                                ("city", DependsOnFixture.City))
                            <time datetime="@DependsOnFixture.KickoffLocal.ToString("o")">@L.Date(Locale, DependsOnFixture.KickoffLocal, "dayMonth")</time>
                            (@DependsOnFixture.TimeZoneLabel).
                        </p>
                    }
                </div>
            }

            <p class="change-row__field-label">@L[Locale, "changeRow.whyLabel"]</p>
            <p class="change-row__why">@Change.ReasonText.For(Locale)</p>

            <p class="change-row__field-label">@L[Locale, "changeRow.nextLabel"]</p>
            <p class="change-row__next">@Change.NextStepText.For(Locale)</p>

            @if (!Change.NextStepIsActionable && Change.DecidedByText is not null)
            {
                @* A dead end still owes the reader a name. "Nothing you can do"
                   with nobody attached to it is the silence this record exists to
                   replace. *@
                <p class="change-row__decided-by">@L.Format(Locale, "changeRow.decidedBy", ("who", Change.DecidedByText.For(Locale)))</p>
            }

            <p class="change-row__mocked">
                @L[Locale, "changeRow.mocked"]
            </p>
        </div>
    </details>
</article>

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }

    [Parameter, EditorRequired]
    public Change Change { get; set; } = default!;

    /// <summary>
    /// The change this one replaces, when it replaces one. Passed in rather
    /// than looked up here so this component stays presentational and does not
    /// need the whole record to draw one row.
    /// </summary>
    [Parameter]
    public Change? Superseded { get; set; }

    /// <summary>
    /// The fixture a conditional change hangs on. Already withheld by the data
    /// provider if it has not been played, so this component can render
    /// whatever it is given without checking anything.
    /// </summary>
    [Parameter]
    public Fixture? DependsOnFixture { get; set; }

    /// <summary>
    /// Whether this row has just been written by the person reading it.
    ///
    /// <para>
    /// It does two things, and both are the confirmation moment the request path
    /// was missing: the row opens rather than arriving collapsed like the rest,
    /// and it animates in rather than appearing indistinguishable from rows that
    /// were already there. A write whose result looks exactly like the existing
    /// list leaves a person wondering whether it worked.
    /// </para>
    /// </summary>
    [Parameter]
    public bool JustArrived { get; set; }

    private bool IsForeseeable => Change.Urgency == Urgency.Foreseeable;
}

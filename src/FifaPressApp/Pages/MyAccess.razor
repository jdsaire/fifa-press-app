@* My Access — the primary surface for a signed-in holder.
   ------------------------------------------------------------------------
   Answers "what do I hold, what changed, and what can I do" without a tap and
   without a network. The match list used to live at "/" and was demoted to
   /matches: landing on fixtures would restate the app this repo already had,
   and no fixture screen can answer what changed about a person's own access.

   It now sits at a named route rather than at "/", which is reserved for the
   public landing view. A "/" that branched on session state would make one
   component decide which *page* it is, tangling the landing's content into this
   screen's error and empty states. The named route also fixes the nav's first
   row: href="" with Match="NavLinkMatch.All" existed only because an empty href
   prefix-matches every address, and href="record" gets a correct active state
   from ordinary prefix matching.

   THE LOADING RULE IS THE POINT. The provider resolves reads from local state
   first, so the headline below is already in hand when this component first
   renders — there is no await in front of it and no spinner over it. Someone
   standing at a barrier with no signal must never wait on a network to see what
   they already had. The schedule, which does need fetching, is loaded
   afterwards and only enriches labels that are already on screen.

   THE STALE ROW IS THE DELIVERABLE. Every other state here degrades politely.
   That one, done wrong, actively misleads: a confident headline, a walk to a
   barrier, a refusal — discovery-by-failure with the app's endorsement on it.
   So StaleIndicator renders always, never only when something is old. *@

@page "/record"
@inject IAccessDataProvider Access
@inject SimulatedSessionProvider Session
@inject NavigationManager Navigation
@inject LocaleService L

<PageTitle>@L[Locale, "record.title"]</PageTitle>

<h1>@L[Locale, "record.title"]</h1>

@if (!Session.IsSignedIn)
{
    @* Gated, and stated as what it is. An access record is personal by
       definition, and one anybody can read without identifying themselves is
       not the person's own state — which is the app's whole premise.

       Never a 403, never "access denied", never anything borrowed from the
       vocabulary of a real authorization system: there is no security here to
       describe. The person is on their way to the sign-in screen, where the
       full simulation notice explains what this is. *@
    <p class="my-access__signed-out">
        @L[Locale, "record.signedOut"]
        <a href="signin">@L[Locale, "record.signedOutLink"]</a>
        @L[Locale, "record.signedOutAfter"]
    </p>
}
else if (loadFailed && record is null)
{
    @* Error — fetch failed, no cache. A dead end with no way out is not an
       acceptable end state, so this routes somewhere a person can act. *@
    <div class="my-access__error" role="alert">
        <h2>@L[Locale, "record.errorHeading"]</h2>
        <p>@L[Locale, "record.errorBody1"]</p>
        <p>@L[Locale, "record.errorBody2"]</p>
        <a class="btn btn-primary" href="help">@L[Locale, "common.whatToDoNext"]</a>
    </div>
}
else if (record is null)
{
    @* Empty — no record. Deliberately not styled like an empty change list:
       "we have no record of you" and "nothing has changed" are different
       facts, and a person who confuses them will wait for a notification that
       is never coming. *@
    <div class="my-access__empty">
        <h2>@L[Locale, "record.emptyHeading"]</h2>
        <p>@L[Locale, "record.emptyBody"]</p>
        <p><a href="help">@L[Locale, "record.emptyLink"]</a></p>
    </div>
}
else
{
    @* 1. The headline, straight from cache. *@
    <AccessCard Accreditation="record">
        <MatchAccess>
            @if (matchAccess.Count == 0)
            {
                <p>@L[Locale, "record.noMatchAccess"]</p>
            }
            else
            {
                <ul class="my-access__matches">
                    @foreach (var line in matchAccess)
                    {
                        <li @key="line.MatchNumber">
                            @* The label is computed here, at render time, from the number and status
                               the line carries. It used to be baked into the line by Rebuild(),
                               which ran once — the stale-string bug, in the one place it
                               genuinely occurred. *@
                            <span class="my-access__match-label">@LabelFor(line.MatchNumber)</span>
                            <span class="my-access__match-status my-access__match-status--@line.Status.ToString().ToLowerInvariant()">
                                @StatusWord(line.Status)
                            </span>
                        </li>
                    }
                </ul>
            }
        </MatchAccess>
    </AccessCard>

    @* 2. Staleness. Always, not only when old. *@
    <StaleIndicator LastSyncedUtc="lastSyncedUtc"
                    AsOfUtc="Access.AsOfUtc"
                    SubjectKey="record.staleSubject" />

    @if (loadFailed)
    {
        @* Error — fetch failed, cache present. Showing cached data as though
           the refresh had succeeded is the quiet lie this whole app exists to
           stop, so the failure is stated rather than swallowed. *@
        <p class="my-access__refresh-failed" role="alert">
            @L[Locale, "record.refreshFailed"]
        </p>
    }

    @* 3 and 4. Changes, newest-effective-first. A change that supersedes an
       earlier one carries that earlier one inside it rather than leaving it
       loose in the list — which is what makes it read as a change and not just
       as two unrelated statements. *@
    <h2 class="my-access__changes-heading">@L[Locale, "record.changesHeading"]</h2>

    @if (visibleChanges.Count == 0)
    {
        <p class="my-access__no-changes">
            @L[Locale, "record.noChangesBefore"]
            <time datetime="@lastSyncedUtc.ToString("o")">@L.Date(Locale, lastSyncedUtc, "dayMonthYearTime")</time> UTC.
            @L[Locale, "record.noChangesAfter"]
        </p>
    }
    else
    {
        @foreach (var change in visibleChanges)
        {
            <ChangeRow @key="change.ChangeId"
                       Change="change"
                       Superseded="@Superseded(change)"
                       DependsOnFixture="@DependsOnFixture(change)" />
        }
    }

    @* 5. Identity and track — stable, secondary, and never competing with the
       headline. *@
    <section class="my-access__identity">
        <h2>@L[Locale, "record.credentialHeading"]</h2>
        <dl>
            <dt>@L[Locale, "record.name"]</dt>
            <dd>@record.HolderName</dd>
            <dt>@L[Locale, "record.outlet"]</dt>
            <dd>@record.Outlet</dd>
            @* Never translated or reformatted in any locale: an identifier is
               not language content. *@
            <dt>@L[Locale, "record.credentialNumber"]</dt>
            <dd>@record.CredentialId</dd>
            <dt>@L[Locale, "record.track"]</dt>
            <dd>@TrackName(record.Track.TrackId)</dd>
        </dl>
        <p class="my-access__mocked">@L[Locale, "record.mocked"]</p>
    </section>

    @* 6. Help, always reachable. *@
    <p class="my-access__help-link">
        <a href="help">@L[Locale, "record.helpLink"]</a>
    </p>
}

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }

    private Accreditation? record;
    private IReadOnlyList<Change> allChanges = [];
    private List<Change> visibleChanges = [];
    private List<MatchAccessLine> matchAccess = [];
    private Dictionary<string, Change> byId = [];
    private Dictionary<int, Fixture> fixtures = [];
    private DateTime lastSyncedUtc;
    private bool loadFailed;

    /// <summary>
    /// One line in the per-fixture block inside the headline.
    ///
    /// <para>
    /// It carries the match number and its status, and deliberately not a
    /// label. The label used to be baked in here by <c>Rebuild()</c>, which runs
    /// once from <c>OnInitializedAsync</c> — so every line kept whichever
    /// language the app was in at that moment and never changed again. That is
    /// exactly the defect <c>11_I18N.md</c> §5.2 describes, and this is the one
    /// place in the app where it genuinely existed.
    /// </para>
    /// </summary>
    private sealed record MatchAccessLine(int MatchNumber, MatchAccessStatus Status);

    protected override async Task OnInitializedAsync()
    {
        // Signed out, there is no record to read and nothing below applies. The
        // markup above has already rendered the offer; this moves the person to
        // the screen that explains what signing in here does and does not mean.
        if (Session.CredentialId is not string credentialId)
        {
            Navigation.NavigateTo("signin", replace: true);
            return;
        }

        // Both of these resolve from local state and complete without yielding,
        // so the first render already has the headline. Nothing below blocks it.
        try
        {
            var accreditation = await Access.GetAccreditationAsync(credentialId);
            record = accreditation.Value;
            lastSyncedUtc = accreditation.LastSyncedUtc;

            var changes = await Access.GetChangesAsync(credentialId);
            allChanges = changes.Value;

            Rebuild();
        }
        catch (Exception)
        {
            loadFailed = true;
        }

        // The schedule needs fetching, so it happens after the headline is
        // already on screen. It only replaces "Match 98" with the round, venue
        // and date — nothing here is waiting on it.
        await LoadFixtureLabelsAsync();
    }

    private void Rebuild()
    {
        byId = allChanges.ToDictionary(change => change.ChangeId, StringComparer.Ordinal);

        var superseded = allChanges
            .Where(change => change.SupersedesChangeId is not null)
            .Select(change => change.SupersedesChangeId!)
            .ToHashSet(StringComparer.Ordinal);

        visibleChanges = allChanges.Where(change => !superseded.Contains(change.ChangeId)).ToList();

        matchAccess = visibleChanges
            .Where(change => change.AffectsMatchNumber is not null)
            .Select(change => change.AffectsMatchNumber!.Value)
            .Distinct()
            .OrderBy(number => number)
            .Select(number => new MatchAccessLine(number, StatusFor(number)))
            .ToList();
    }

    private async Task LoadFixtureLabelsAsync()
    {
        foreach (var number in matchAccess.Select(line => line.MatchNumber)
                     .Concat(allChanges.Where(c => c.DependsOnMatchNumber is not null)
                         .Select(c => c.DependsOnMatchNumber!.Value))
                     .Distinct()
                     .ToList())
        {
            try
            {
                var fixture = (await Access.GetFixtureAsync(number)).Value;
                if (fixture is not null)
                {
                    fixtures[number] = fixture;
                }
            }
            catch (Exception)
            {
                // A label that will not load leaves the match number showing,
                // which is still a true statement about the person's access.
            }
        }

        if (record is not null)
        {
            Rebuild();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Whatever the provider handed back. A fixture that has not been played
    /// arrives with no team names on it, so this renders the round and venue
    /// instead without needing to know that is why.
    /// </summary>
    private string LabelFor(int matchNumber) =>
        fixtures.TryGetValue(matchNumber, out var fixture)
            ? L.Format(Locale, "record.matchLabelWithFixture",
                ("number", matchNumber),
                ("label", FixtureLabels.Display(L, Locale, fixture)),
                ("city", fixture.City))
            : L.Format(Locale, "record.matchLabel", ("number", matchNumber));

    private MatchAccessStatus StatusFor(int matchNumber)
    {
        var latest = visibleChanges
            .Where(change => change.AffectsMatchNumber == matchNumber)
            .OrderByDescending(change => change.EffectiveUtc)
            .FirstOrDefault();

        return latest?.Kind switch
        {
            ChangeKind.MatchAccessGranted => MatchAccessStatus.Granted,
            ChangeKind.MatchAccessRevoked => MatchAccessStatus.Revoked,
            ChangeKind.RequestDecided => MatchAccessStatus.Requested,
            _ => MatchAccessStatus.NotRequested,
        };
    }

    private Change? Superseded(Change change) =>
        change.SupersedesChangeId is not null && byId.TryGetValue(change.SupersedesChangeId, out var earlier)
            ? earlier
            : null;

    private Fixture? DependsOnFixture(Change change) =>
        change.DependsOnMatchNumber is int number && fixtures.TryGetValue(number, out var fixture)
            ? fixture
            : null;

    /// <summary>
    /// A revoked-but-conditional entry is not yet revoked, and saying so
    /// plainly here matters more than the word being short.
    /// </summary>
    private string StatusWord(MatchAccessStatus status) => L[Locale, status switch
    {
        MatchAccessStatus.Granted => "status.granted",
        MatchAccessStatus.Revoked => "status.revoked",
        MatchAccessStatus.Requested => "status.requested",
        _ => "status.notRequested",
    }];

    private string TrackName(TrackId track) => L[Locale, track switch
    {
        TrackId.MemberAssociationQuota => "track.memberAssociationQuota",
        TrackId.RightsHolder => "track.rightsHolder",
        TrackId.Freelance => "track.freelance",
        _ => "track.unknown",
    }];
}

@* Sign in — a simulated session, and the screen says so before anything else.
   ------------------------------------------------------------------------
   This is no longer the inert form v9 shipped. There is a session now, it is
   real enough to change what renders, and it gates the record. What there is
   NOT is an account system: no server, no token, no verification, and two
   passwords compiled into the app and printed a few inches below the field
   they go in.

   That is exactly why the notice had to be rewritten rather than kept. v9's
   notice said nothing is sent, stored, or checked, and that the whole app is
   reachable without signing in. Both halves are now false, and a notice that
   has quietly become false is worse than no notice — it is the lie-by-interface
   this app exists to argue against, told about itself.

   CARRIED FORWARD FROM v9, UNCHANGED, and deliberately not re-derived: the
   EditForm/EditContext/DataAnnotationsValidator structure, autocomplete
   attributes, type="password", the IdentifierInputMode switch, ValidationMessage
   with aria-live per field and role="alert" on the form-level error, the
   PermissiveIdentifier allow-list and its reasoning, and the single generic
   failure message. The reference's injection blocklist is still not adopted:
   it rejects apostrophes and the substring " or ", which turns away O'Neill,
   D'Angelo and Ba'ath. *@

@page "/signin"
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@inject SimulatedSessionProvider Session
@inject DemoAccountStore Accounts
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<h1>Sign in</h1>

@* Visible before any interaction, and first on the page. The four things it
   states are in the order 10 §2.3 sets: what this is, that the credentials
   below are real and work, how long the session lasts, and what it is not. *@
<div class="signin__notice" role="note">
    <p>
        <strong>This is a simulated sign-in.</strong>
        There is no account system behind it — no server, no verification, and
        nothing that could tell you apart from anyone else.
    </p>
    <p>
        The credentials below are fake, published on purpose, and
        <strong>they work</strong>. They are the only two that do.
    </p>
    <p>
        The session lives in memory for as long as this tab does.
        <strong>Refreshing the page signs you out</strong>, because storing it
        would make this look more like an account system than it is.
    </p>
    <p>
        It is a demonstration of what this app shows a signed-in holder.
        <strong>It is not a security boundary and it protects nothing.</strong>
    </p>
</div>

@* Adjacent to the form, not behind a disclosure. Each account says whose
   record it opens and what makes that record worth looking at — a person who
   signs in as one and then the other should be told, beforehand, that the
   difference is the point. *@
<section class="signin__accounts">
    <h2>The two demo accounts</h2>

    <ul class="signin__account-list">
        @foreach (var account in Accounts.Published)
        {
            <li class="signin__account" @key="account.CredentialId">
                <h3>@account.HolderName</h3>
                <dl>
                    <dt>Email or credential number</dt>
                    <dd><code>@account.Identifier</code></dd>
                    <dt>Password</dt>
                    <dd><code>@account.Password</code></dd>
                </dl>
                <p class="signin__account-note">@account.WhatIsDifferent</p>
            </li>
        }
    </ul>

    <p class="signin__account-hint">
        Sign in as one, read the change list, then sign out and sign in as the
        other. The same conditional change sits on both records and behaves
        differently, and that difference is derived from the record — never from
        a setting either of them chose.
    </p>
</section>

<EditForm EditContext="editContext" OnValidSubmit="HandleSubmitAsync" class="signin__form">
    <DataAnnotationsValidator />

    <div class="signin__field">
        <label for="signin-identifier">Email or credential number</label>
        <InputText id="signin-identifier"
                   class="form-control"
                   autocomplete="username"
                   inputmode="@IdentifierInputMode"
                   disabled="@submitting"
                   @bind-Value="model.Identifier"
                   @bind-Value:event="oninput" />
        <ValidationMessage For="@(() => model.Identifier)" class="signin__error" aria-live="polite" />
    </div>

    <div class="signin__field">
        <label for="signin-password">Password</label>
        @* type="password" and current-password, and nothing else touches this
           value: it is never trimmed, pattern-checked, rewritten, logged, or
           put in a query string. Allow-list rewriting is right for a username
           and wrong for a password, which has to compare byte for byte — and
           now that a real comparison happens, that is a tested rule rather
           than a stated intention. *@
        <InputText id="signin-password"
                   type="password"
                   class="form-control"
                   autocomplete="current-password"
                   disabled="@submitting"
                   @bind-Value="model.Password" />
        <ValidationMessage For="@(() => model.Password)" class="signin__error" aria-live="polite" />
    </div>

    @if (formError is not null)
    {
        <p class="signin__error" role="alert">@formError</p>
    }

    <button type="submit" class="btn btn-primary" disabled="@submitting">
        @(submitting ? "Signing in…" : "Sign in")
    </button>
</EditForm>

@code {
    private readonly SignInModel model = new();
    private EditContext editContext = default!;
    private string? formError;
    private bool submitting;

    /// <summary>
    /// One message for any failure. Saying which of the two was wrong would tell
    /// an attacker which half they had right. With both passwords published
    /// above this is arguably ceremony — it is kept because the pattern is
    /// correct, and a demonstration that models the wrong pattern teaches the
    /// wrong pattern.
    /// </summary>
    private const string GenericFailure =
        "That identifier and password do not match a demo account. Both are published above.";

    protected override void OnInitialized()
    {
        editContext = new EditContext(model);

        // Already signed in: there is nothing here for them, and rendering a
        // sign-in form to someone who has a session invites them to wonder
        // whether they now have two.
        if (Session.IsSignedIn)
        {
            Navigation.NavigateTo("record", replace: true);
        }
    }

    /// <summary>
    /// Nudges the on-screen keyboard toward an email layout once the value
    /// looks like an address, and leaves it alone for a credential number.
    /// </summary>
    private string? IdentifierInputMode =>
        model.Identifier.Contains('@') ? "email" : null;

    private async Task HandleSubmitAsync()
    {
        formError = null;
        submitting = true;

        // The session's simulated latency is what makes this state reachable:
        // the await genuinely yields, so a render pass happens here and the
        // disabled fields and the "Signing in…" label get their chance to
        // appear.
        var succeeded = await Session.SignInAsync(model.Identifier, model.Password);

        submitting = false;

        if (!succeeded)
        {
            // The typed identifier is left in place. Clearing the form on a
            // failure makes a person retype something that was probably right.
            formError = GenericFailure;
            return;
        }

        // No result panel and no success message: the person is on their
        // record, and the sidebar indicator naming them is the confirmation.
        Navigation.NavigateTo("record");
    }

    private sealed class SignInModel
    {
        [Required(ErrorMessage = "Enter your email or credential number.")]
        [StringLength(120, MinimumLength = 3, ErrorMessage = "This must be between 3 and 120 characters.")]
        [PermissiveIdentifier]
        public string Identifier { get; set; } = string.Empty;

        // Length bound only. No allow-list, no pattern, no sanitising.
        [Required(ErrorMessage = "Enter your password.")]
        [StringLength(200, MinimumLength = 1, ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }

    /// <summary>
    /// An allow-list wide enough for real names and real credential numbers:
    /// any letter in any script, any digit, spaces, and the handful of marks
    /// that legitimately appear in both — hyphen, apostrophe, period,
    /// underscore and the at sign.
    ///
    /// <para>
    /// The apostrophe is here on purpose. A list that rejects it rejects
    /// O'Neill, D'Angelo and Ba'ath, which is not a stricter defence — it is a
    /// form that turns away the people it exists to serve.
    /// </para>
    /// </summary>
    private sealed class PermissiveIdentifierAttribute : ValidationAttribute
    {
        private static readonly Regex AllowedCharacters =
            new(@"^[\p{L}\p{N} .\-'_@]+$", RegexOptions.CultureInvariant);

        public PermissiveIdentifierAttribute() =>
            ErrorMessage = "Use letters, numbers, spaces, and the marks . - ' _ @ only.";

        public override bool IsValid(object? value)
        {
            if (value is not string text || text.Length == 0)
            {
                // Presence is [Required]'s job, not this one's.
                return true;
            }

            return AllowedCharacters.IsMatch(text);
        }
    }
}

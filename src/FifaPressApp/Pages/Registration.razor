@* Request access — the app's only write surface.
   ------------------------------------------------------------------------
   Renamed throughout from "Register", and the route moved with it. "Register"
   read as account creation, which is not what this does: nothing here creates a
   person, it asks for access to one match. The rename was the single
   highest-value naming change in the whole concept and it was unanimous.

   On success this returns to My Access rather than showing a confirmation
   screen of its own. The confirmation *is* the change appearing in the record —
   a separate "thanks, we got that" page would be a second place where a state
   movement is announced, and the record is meant to be the only one.

   There is no cancel affordance, and its absence is deliberate. Reversing a
   request is a write that appends a withdrawal to the record, not an undo that
   erases anything, and no surface for it has been specified. Adding one here
   would be inventing scope rather than completing it. *@

@page "/request/{Id:int}"
@inject IAccessDataProvider Access
@inject SimulatedSessionProvider Session
@inject NavigationManager Navigation

<PageTitle>@PageHeading</PageTitle>

<nav aria-label="breadcrumb" class="mb-2">
    <NavLink href="matches">Matches</NavLink> <span aria-hidden="true">/</span> <span>@PageHeading</span>
</nav>

<h1>@PageHeading</h1>

@if (!Session.IsSignedIn)
{
    @* This is a write to a personal record, which is the reason it is gated
       and the reason worth stating: a request submitted with no holder
       attached either goes nowhere or goes to an arbitrary record, and both
       are worse than asking who you are first. *@
    <p class="request__signed-out">
        Requesting access writes to a holder's own record, so this asks who you
        are first. <a href="signin">Sign in with a demo account</a> — it is a
        demonstration, not a security check, and the sign-in page says so.
    </p>
}
else if (!loaded)
{
    <p class="request__loading">Loading this match…</p>
}
else if (fixture is null)
{
    <p class="request__error" role="alert">No match has this number.</p>
}
else
{
    <p>You are requesting access to:</p>

    <EventCard EventName="@fixture.DisplayLabel"
               EventDate="fixture.KickoffLocal"
               Location="@($"{fixture.Venue}, {fixture.City}")"
               ReadOnly="true"
               AllowEdit="false" />

    <p class="request__meta">
        <Icon Name="phase" />@fixture.PhaseLabel ·
        <time datetime="@fixture.KickoffLocal.ToString("o")">@fixture.KickoffLocal.ToString("d MMMM yyyy, HH:mm")</time>
        @fixture.TimeZoneLabel
    </p>

    <RequestAccessForm @bind-Name="name"
                       @bind-Email="email"
                       Submitting="submitting"
                       ErrorMessage="@errorMessage"
                       OnSubmit="SubmitAsync" />

    <p class="request__mocked">
        Simulated request. Nothing is sent anywhere in this version — submitting
        writes a change to the simulated record and returns you to it.
    </p>
}

<NavLink class="btn btn-outline-secondary btn-sm mt-3" href="matches">Back to matches</NavLink>

@code {
    /// <summary>The match number, taken from the address.</summary>
    [Parameter]
    public int Id { get; set; }

    private Fixture? fixture;
    private string name = string.Empty;
    private string email = string.Empty;
    private bool loaded;
    private bool submitting;
    private string? errorMessage;

    private string PageHeading => fixture is null
        ? "Match not found"
        : $"Request access to match {fixture.MatchNumber}";

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;

        if (!Session.IsSignedIn)
        {
            // The offer is already rendered above. Nothing is fetched for a
            // visitor who cannot submit the form the fetch is for.
            Navigation.NavigateTo("signin", replace: true);
            return;
        }

        try
        {
            fixture = (await Access.GetFixtureAsync(Id)).Value;
        }
        catch (Exception)
        {
            fixture = null;
        }

        loaded = true;
    }

    private async Task SubmitAsync()
    {
        if (Session.CredentialId is not string credentialId)
        {
            // Belt and braces. The form is not rendered without a session, so
            // this is unreachable through the interface — and it is here
            // because a write with no holder attached is the one outcome this
            // gate exists to prevent, and "unreachable" is a property of
            // today's markup rather than of the write path.
            errorMessage = "Your session ended. Sign in again to send this request.";
            return;
        }

        submitting = true;
        errorMessage = null;

        try
        {
            // The write returns the change it produced. There is no separate
            // success flag to check, because the change is the outcome — and a
            // write that could report success without producing one would be
            // exactly the second write path this record forbids.
            await Access.RequestMatchAccessAsync(credentialId, Id);

            // Straight back to the record, where the change is now the newest
            // entry. What was typed stays in the fields until this navigation
            // completes, so a failure leaves the form recoverable.
            Navigation.NavigateTo("record");
        }
        catch (Exception)
        {
            submitting = false;
            errorMessage = "That request could not be recorded. Your details are still here — try again.";
        }
    }
}

@* Match detail.
   ------------------------------------------------------------------------
   One fixture, the access this holder has for it, and — when it applies — the
   fact that a pending entitlement hangs on this match's outcome.

   Four things changed here from the version this replaces:
     · the per-match request count is gone. It told the holder nothing about
       her own entitlement and implied a competition she cannot act on;
     · the "Registered" badge is now an access-status label. "Registered"
       describes an account, not an entitlement;
     · kickoff carries an explicit timezone label, which is not optional across
       three host countries;
     · a gate check can be run, and its result is a state of this page rather
       than a screen of its own — it has no route and nothing navigates to it.

   The staleness indicator sits on the access status specifically, not on the
   fixture. Kickoff times do not go out of date the way entitlements do, and
   putting one indicator over both would imply they age together. *@

@page "/events/{Id:int}"
@inject IAccessDataProvider Access
@inject SimulatedSessionProvider Session
@inject LocaleService L

<PageTitle>@PageHeading</PageTitle>

<nav aria-label="breadcrumb" class="mb-2">
    <NavLink href="matches">@L[Locale, "detail.breadcrumb"]</NavLink> <span aria-hidden="true">/</span> <span>@PageHeading</span>
</nav>

<h1>@PageHeading</h1>

@if (!loaded)
{
    <p class="detail__loading">@L[Locale, "common.loadingMatch"]</p>
}
else if (fixture is null)
{
    @* The address is a valid shape (/events/9999) but no fixture has that
       number, which routing alone cannot catch. *@
    <p class="detail__error" role="alert">@L[Locale, "common.noMatchNumber"]</p>
}
else
{
    <EventCard EventName="@FixtureLabels.Display(L, Locale, fixture)"
               EventDate="fixture.KickoffLocal"
               Location="@($"{fixture.Venue}, {fixture.City}")"
               ReadOnly="true"
               AllowEdit="false" />

    <p class="detail__kickoff">
        @L[Locale, "detail.kicksOff"]
        <time datetime="@fixture.KickoffLocal.ToString("o")">@L.Date(Locale, fixture.KickoffLocal, "dayMonthYearTime")</time>
        <strong>@fixture.TimeZoneLabel</strong> · <Icon Name="phase" />@FixtureLabels.Phase(L, Locale, fixture)
    </p>

    @if (!fixture.IsResolved)
    {
        <p class="detail__unplayed">@L[Locale, "detail.unplayed"]</p>
    }

    <section class="detail__access">
        <h2>@L[Locale, "detail.accessHeading"]</h2>

        @if (!Session.IsSignedIn)
        {
            @* The affordance is stated, not concealed. A hidden or dead control
               would leave a person guessing whether the app has an opinion
               about their access; this says plainly that it has one and what it
               needs in order to give it. *@
            <p class="detail__signed-out">
                @L[Locale, "detail.signedOut"]
                <a href="signin">@L[Locale, "detail.signedOutLink"]</a>
                @L[Locale, "detail.signedOutAfter"]
            </p>
        }
        else if (accessLoadFailed)
        {
            @* Stated plainly rather than defaulted to "no access". Showing a
               person "no access" because a lookup failed would send them away
               from a barrier they were entitled to walk through. *@
            <p class="detail__error" role="alert">@L[Locale, "detail.accessError"]</p>
            <p><a href="help">@L[Locale, "detail.barrierHelp"]</a></p>
        }
        else
        {
            <p class="detail__status detail__status--@status.ToString().ToLowerInvariant()">@StatusSentence</p>

            <StaleIndicator LastSyncedUtc="lastSyncedUtc"
                            AsOfUtc="Access.AsOfUtc"
                            SubjectKey="detail.staleSubject" />

            @if (status == MatchAccessStatus.NotRequested)
            {
                <NavLink class="btn btn-primary btn-sm" href="@($"request/{Id}")">@L[Locale, "detail.requestAccess"]</NavLink>
            }
        }
    </section>

    @if (Session.IsSignedIn && dependentChange is not null)
    {
        @* Interaction 4.2. Worded as a condition with both outcomes named —
           never as a commitment, because the condition is by definition
           unresolved. *@
        <section class="detail__dependency">
            <h2>@L[Locale, "detail.dependencyHeading"]</h2>
            <ForeseeableBadge />
            <p>@dependentChange.ConditionTextLocalized?.For(Locale)</p>
            <p class="detail__mocked">@L[Locale, "detail.dependencyMocked"]</p>
        </section>
    }

    @* The gate check compares this holder's record against the venue list, so
       it is as personal as the record is. Signed out there are no two sides to
       compare, and running it against an empty record would manufacture an
       agreement about nothing. *@
    @if (Session.IsSignedIn)
    {
    <section class="detail__gate">
        <h2>@L[Locale, "detail.gateHeading"]</h2>

        @if (gateResult is null)
        {
            <p>@L[Locale, "detail.gateIntro"]</p>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RunGateCheck">
                @L[Locale, "detail.gateRun"]
            </button>
        }
        else if (gateResult == GateOutcome.Agreement)
        {
            <p class="detail__gate-agree" role="status">
                <strong>@L[Locale, "detail.gateAgreeStrong"]</strong>
                @L[Locale, "detail.gateAgreeBoth"] @StatusSentence
            </p>
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => gateResult = null">@L[Locale, "detail.gateRunAgain"]</button>
        }
        else
        {
            @* THE DISAGREEMENT STATE. Both sides shown, timestamped, with a
               route to a human. This screen does not decide which side is
               right, and no copy on it may imply that it knows — who owns the
               venue access list is genuinely unresolved, so arbitrating here
               would be a guess presented as an answer. *@
            <div class="detail__gate-disagree" role="alert">
                <p><strong>@L[Locale, "detail.gateDisagreeStrong"]</strong></p>
                <dl>
                    <dt>@L[Locale, "detail.gateYourRecord"]</dt>
                    <dd>
                        @StatusWord(status) —
                        <time datetime="@lastSyncedUtc.ToString("o")">@L.Format(Locale, "detail.gateAsOf", ("timestamp", L.Date(Locale, lastSyncedUtc, "dayShortMonthTime")))</time> UTC
                    </dd>
                    <dt>@L[Locale, "detail.gateVenueList"]</dt>
                    <dd>
                        @StatusWord(venueStatus) —
                        <time datetime="@VenueListAsOf.ToString("o")">@L.Format(Locale, "detail.gateAsOf", ("timestamp", L.Date(Locale, VenueListAsOf, "dayShortMonthTime")))</time> UTC
                    </dd>
                </dl>
                <p>@L[Locale, "detail.gateResolution"]</p>
                <a class="btn btn-primary btn-sm" href="help">@L[Locale, "common.whoToContact"]</a>
            </div>
            <p class="detail__mocked">@L[Locale, "detail.gateMocked"]</p>
        }
    </section>
    }
}

<NavLink class="btn btn-outline-secondary btn-sm mt-3" href="matches">@L[Locale, "common.backToMatches"]</NavLink>

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }

    /// <summary>The match number, taken from the address.</summary>
    [Parameter]
    public int Id { get; set; }

    private enum GateOutcome { Agreement, Disagreement }

    /// <summary>
    /// How far behind the record the simulated venue list runs. A venue list
    /// that is stale by the time it matters is the actual failure at a
    /// barrier, so the simulation reproduces it rather than pretending the two
    /// sides are always in step.
    /// </summary>
    private static readonly TimeSpan VenueListLag = TimeSpan.FromHours(24);

    private Fixture? fixture;
    private IReadOnlyList<Change> changes = [];
    private Change? dependentChange;
    private MatchAccessStatus status;
    private MatchAccessStatus venueStatus;
    private GateOutcome? gateResult;
    private DateTime lastSyncedUtc;
    private bool loaded;
    private bool accessLoadFailed;

    private DateTime VenueListAsOf => Access.AsOfUtc - VenueListLag;

    private string PageHeading => fixture is null
        ? L[Locale, "detail.notFound"]
        : L.Format(Locale, "detail.heading",
            ("number", fixture.MatchNumber),
            ("label", FixtureLabels.Display(L, Locale, fixture)));

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        gateResult = null;
        accessLoadFailed = false;

        try
        {
            var response = await Access.GetFixtureAsync(Id);
            fixture = response.Value;
        }
        catch (Exception)
        {
            fixture = null;
        }

        // Signed out, there is no personal state to fold and no credential to
        // fold it for. This branch deliberately does NOT return early: an early
        // return here would skip the line below and freeze a signed-out visitor
        // on "Loading this match…" forever, on a page that is supposed to be
        // public. The fixture above is what they came for and it is already in
        // hand.
        if (Session.CredentialId is string credentialId)
        {
            try
            {
                var changeResponse = await Access.GetChangesAsync(credentialId);
                changes = changeResponse.Value;
                lastSyncedUtc = changeResponse.LastSyncedUtc;

                status = FoldStatus(DateTime.MaxValue);
                venueStatus = FoldStatus(VenueListAsOf);
                dependentChange = changes.FirstOrDefault(change => change.DependsOnMatchNumber == Id);
            }
            catch (Exception)
            {
                accessLoadFailed = true;
            }
        }
        else
        {
            changes = [];
            dependentChange = null;
        }

        loaded = true;
    }

    /// <summary>
    /// Folds this match's access status out of the change log, counting only
    /// changes that had taken effect by <paramref name="asOf"/>. Passing the
    /// venue list's older cutoff is what produces the two sides of a
    /// disagreement out of one record.
    /// </summary>
    private MatchAccessStatus FoldStatus(DateTime asOf)
    {
        var superseded = changes
            .Where(change => change.SupersedesChangeId is not null)
            .Select(change => change.SupersedesChangeId!)
            .ToHashSet(StringComparer.Ordinal);

        var latest = changes
            .Where(change => change.AffectsMatchNumber == Id
                          && change.EffectiveUtc <= asOf
                          && !superseded.Contains(change.ChangeId))
            .OrderByDescending(change => change.EffectiveUtc)
            .FirstOrDefault();

        return latest?.Kind switch
        {
            ChangeKind.MatchAccessGranted => MatchAccessStatus.Granted,
            ChangeKind.MatchAccessRevoked => MatchAccessStatus.Revoked,
            ChangeKind.RequestDecided => MatchAccessStatus.Requested,
            ChangeKind.Withdrawal => MatchAccessStatus.NotRequested,
            _ => MatchAccessStatus.NotRequested,
        };
    }

    private void RunGateCheck() =>
        gateResult = status == venueStatus ? GateOutcome.Agreement : GateOutcome.Disagreement;

    private string StatusSentence => L[Locale, status switch
    {
        MatchAccessStatus.Granted => "detail.statusGranted",
        MatchAccessStatus.Revoked => "detail.statusRevoked",
        MatchAccessStatus.Requested => "detail.statusRequested",
        _ => "detail.statusNotRequested",
    }];

    private string StatusWord(MatchAccessStatus value) => L[Locale, value switch
    {
        MatchAccessStatus.Granted => "status.granted",
        MatchAccessStatus.Revoked => "status.revoked",
        MatchAccessStatus.Requested => "status.requested",
        _ => "status.notRequested",
    }];
}

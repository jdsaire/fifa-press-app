@* Match detail.
   ------------------------------------------------------------------------
   One fixture, the access this holder has for it, and — when it applies — the
   fact that a pending entitlement hangs on this match's outcome.

   Four things changed here from the version this replaces:
     · the per-match request count is gone. It told the holder nothing about
       her own entitlement and implied a competition she cannot act on;
     · the "Registered" badge is now an access-status label. "Registered"
       describes an account, not an entitlement;
     · kickoff carries an explicit timezone label, which is not optional across
       three host countries;
     · a gate check can be run, and its result is a state of this page rather
       than a screen of its own — it has no route and nothing navigates to it.

   The staleness indicator sits on the access status specifically, not on the
   fixture. Kickoff times do not go out of date the way entitlements do, and
   putting one indicator over both would imply they age together. *@

@page "/events/{Id:int}"
@inject IAccessDataProvider Access

<PageTitle>@PageHeading</PageTitle>

<nav aria-label="breadcrumb" class="mb-2">
    <NavLink href="matches">Matches</NavLink> <span aria-hidden="true">/</span> <span>@PageHeading</span>
</nav>

<h1>@PageHeading</h1>

@if (!loaded)
{
    <p class="detail__loading">Loading this match…</p>
}
else if (fixture is null)
{
    @* The address is a valid shape (/events/9999) but no fixture has that
       number, which routing alone cannot catch. *@
    <p class="detail__error" role="alert">No match has this number.</p>
}
else
{
    <EventCard EventName="@fixture.DisplayLabel"
               EventDate="fixture.KickoffLocal"
               Location="@($"{fixture.Venue}, {fixture.City}")"
               ReadOnly="true"
               AllowEdit="false" />

    <p class="detail__kickoff">
        Kicks off
        <time datetime="@fixture.KickoffLocal.ToString("o")">@fixture.KickoffLocal.ToString("d MMMM yyyy, HH:mm")</time>
        <strong>@fixture.TimeZoneLabel</strong> · @fixture.PhaseLabel
    </p>

    @if (!fixture.IsResolved)
    {
        <p class="detail__unplayed">
            This match has not been played, so the teams in it are not shown.
        </p>
    }

    <section class="detail__access">
        <h2>Your access to this match</h2>

        @if (accessLoadFailed)
        {
            @* Stated plainly rather than defaulted to "no access". Showing a
               person "no access" because a lookup failed would send them away
               from a barrier they were entitled to walk through. *@
            <p class="detail__error" role="alert">
                Your access status for this match could not be read. This is not
                the same as having no access — it means this app cannot tell you
                either way right now.
            </p>
            <p><a href="help">What to do at the barrier</a></p>
        }
        else
        {
            <p class="detail__status detail__status--@status.ToString().ToLowerInvariant()">@StatusSentence</p>

            <StaleIndicator LastSyncedUtc="lastSyncedUtc"
                            AsOfUtc="Access.AsOfUtc"
                            Subject="your access status" />

            @if (status == MatchAccessStatus.NotRequested)
            {
                <NavLink class="btn btn-primary btn-sm" href="@($"request/{Id}")">Request access</NavLink>
            }
        }
    </section>

    @if (dependentChange is not null)
    {
        @* Interaction 4.2. Worded as a condition with both outcomes named —
           never as a commitment, because the condition is by definition
           unresolved. *@
        <section class="detail__dependency">
            <h2>An entitlement depends on this match</h2>
            <ForeseeableBadge />
            <p>@dependentChange.ConditionText</p>
            <p class="detail__mocked">
                Simulated dependency. In this version the link between a fixture
                and an entitlement is mocked, and no results feed is connected.
            </p>
        </section>
    }

    <section class="detail__gate">
        <h2>Gate check</h2>

        @if (gateResult is null)
        {
            <p>
                Compare what this app holds against what the venue's access list
                says, as a barrier check would.
            </p>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RunGateCheck">
                Run a simulated gate check
            </button>
        }
        else if (gateResult == GateOutcome.Agreement)
        {
            <p class="detail__gate-agree" role="status">
                <strong>The venue list agrees with your record.</strong>
                Both show: @StatusSentence
            </p>
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => gateResult = null">Run it again</button>
        }
        else
        {
            @* THE DISAGREEMENT STATE. Both sides shown, timestamped, with a
               route to a human. This screen does not decide which side is
               right, and no copy on it may imply that it knows — who owns the
               venue access list is genuinely unresolved, so arbitrating here
               would be a guess presented as an answer. *@
            <div class="detail__gate-disagree" role="alert">
                <p><strong>The venue list and your record do not agree.</strong></p>
                <dl>
                    <dt>Your record says</dt>
                    <dd>
                        @StatusWord(status) —
                        <time datetime="@lastSyncedUtc.ToString("o")">as of @lastSyncedUtc.ToString("d MMM, HH:mm")</time> UTC
                    </dd>
                    <dt>The venue list says</dt>
                    <dd>
                        @StatusWord(venueStatus) —
                        <time datetime="@VenueListAsOf.ToString("o")">as of @VenueListAsOf.ToString("d MMM, HH:mm")</time> UTC
                    </dd>
                </dl>
                <p>
                    This app cannot establish which of the two is correct, and it
                    does not try to. Show both timestamps to the accreditation
                    supervisor at the venue and let them resolve it against their
                    own system.
                </p>
                <a class="btn btn-primary btn-sm" href="help">Who to contact</a>
            </div>
            <p class="detail__mocked">
                Simulated gate check. No venue access list is connected in this
                version, and which system owns that list is an open question
                this app does not answer.
            </p>
        }
    </section>
}

<NavLink class="btn btn-outline-secondary btn-sm mt-3" href="matches">Back to matches</NavLink>

@code {
    /// <summary>The match number, taken from the address.</summary>
    [Parameter]
    public int Id { get; set; }

    private enum GateOutcome { Agreement, Disagreement }

    /// <summary>
    /// How far behind the record the simulated venue list runs. A venue list
    /// that is stale by the time it matters is the actual failure at a
    /// barrier, so the simulation reproduces it rather than pretending the two
    /// sides are always in step.
    /// </summary>
    private static readonly TimeSpan VenueListLag = TimeSpan.FromHours(24);

    private Fixture? fixture;
    private IReadOnlyList<Change> changes = [];
    private Change? dependentChange;
    private MatchAccessStatus status;
    private MatchAccessStatus venueStatus;
    private GateOutcome? gateResult;
    private DateTime lastSyncedUtc;
    private bool loaded;
    private bool accessLoadFailed;

    private DateTime VenueListAsOf => Access.AsOfUtc - VenueListLag;

    private string PageHeading => fixture is null
        ? "Match not found"
        : $"Match {fixture.MatchNumber} — {fixture.DisplayLabel}";

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        gateResult = null;
        accessLoadFailed = false;

        try
        {
            var response = await Access.GetFixtureAsync(Id);
            fixture = response.Value;
        }
        catch (Exception)
        {
            fixture = null;
        }

        try
        {
            var changeResponse = await Access.GetChangesAsync(MockAccessDataProvider.DemoCredentialId);
            changes = changeResponse.Value;
            lastSyncedUtc = changeResponse.LastSyncedUtc;

            status = FoldStatus(DateTime.MaxValue);
            venueStatus = FoldStatus(VenueListAsOf);
            dependentChange = changes.FirstOrDefault(change => change.DependsOnMatchNumber == Id);
        }
        catch (Exception)
        {
            accessLoadFailed = true;
        }

        loaded = true;
    }

    /// <summary>
    /// Folds this match's access status out of the change log, counting only
    /// changes that had taken effect by <paramref name="asOf"/>. Passing the
    /// venue list's older cutoff is what produces the two sides of a
    /// disagreement out of one record.
    /// </summary>
    private MatchAccessStatus FoldStatus(DateTime asOf)
    {
        var superseded = changes
            .Where(change => change.SupersedesChangeId is not null)
            .Select(change => change.SupersedesChangeId!)
            .ToHashSet(StringComparer.Ordinal);

        var latest = changes
            .Where(change => change.AffectsMatchNumber == Id
                          && change.EffectiveUtc <= asOf
                          && !superseded.Contains(change.ChangeId))
            .OrderByDescending(change => change.EffectiveUtc)
            .FirstOrDefault();

        return latest?.Kind switch
        {
            ChangeKind.MatchAccessGranted => MatchAccessStatus.Granted,
            ChangeKind.MatchAccessRevoked => MatchAccessStatus.Revoked,
            ChangeKind.RequestDecided => MatchAccessStatus.Requested,
            ChangeKind.Withdrawal => MatchAccessStatus.NotRequested,
            _ => MatchAccessStatus.NotRequested,
        };
    }

    private void RunGateCheck() =>
        gateResult = status == venueStatus ? GateOutcome.Agreement : GateOutcome.Disagreement;

    private string StatusSentence => status switch
    {
        MatchAccessStatus.Granted => "Access granted for this match.",
        MatchAccessStatus.Revoked => "Access to this match has been withdrawn. See your record for the reason.",
        MatchAccessStatus.Requested => "Requested. No decision has been taken yet.",
        _ => "You have not requested access to this match.",
    };

    private static string StatusWord(MatchAccessStatus value) => value switch
    {
        MatchAccessStatus.Granted => "Access granted",
        MatchAccessStatus.Revoked => "Access withdrawn",
        MatchAccessStatus.Requested => "Requested, not yet decided",
        _ => "Not requested",
    };
}

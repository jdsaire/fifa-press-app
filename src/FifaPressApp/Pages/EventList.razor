@* Matches — a supporting surface, and honest about being one.
   ------------------------------------------------------------------------
   No task in this concept ends here. It exists because it is the only route to
   a match's detail page, which two tasks do need. A fixture list is navigation
   infrastructure, not the thing this app is about, which is why it moved off
   the front door.

   Note what is deliberately absent: no access status, no request count. Access
   belongs to the person and lives on the record; scattering it across as many
   screens as there are fixtures is precisely how the old app made "what changed
   about my access" unanswerable. A count of other people's requests tells the
   reader nothing about their own entitlement and implies a competition they
   cannot act on.

   THE ONE THING THIS PAGE NOW READS FROM THE SESSION is whether there is one,
   and it reads it here rather than in the card. A signed-out visitor cannot
   request access to anything, so offering the control and failing on the far
   side of it would be a dead end dressed as an affordance; a played fixture
   cannot be requested by anyone, because it is over. Both of those are the
   page's decisions to make, and each reaches the card as a plain bool.

   Fixtures whose kickoff has not passed arrive here with no team names on
   them — the data layer withholds them — so this page renders whatever label it
   is handed without needing to know why. *@

@page "/matches"
@inject IAccessDataProvider Access
@inject SimulatedSessionProvider Session
@inject LocaleService L

<PageTitle>@L[Locale, "matches.title"]</PageTitle>

<h1>@L[Locale, "matches.title"]</h1>

@if (loadFailed)
{
    <div class="matches__error" role="alert">
        <p>@L[Locale, "matches.errorBody"]</p>
        <button type="button" class="btn btn-primary" @onclick="ReloadAsync">@L[Locale, "common.tryAgain"]</button>
    </div>
}
else
{
    <StaleIndicator LastSyncedUtc="lastSyncedUtc"
                    AsOfUtc="Access.AsOfUtc"
                    SubjectKey="matches.staleSubject"
                    StaleAfter="TimeSpan.FromHours(24)" />

    <input type="search" class="form-control mb-3" placeholder="@L[Locale, "matches.searchPlaceholder"]"
           value="@searchTerm" @oninput="OnSearchInput"
           aria-label="@L[Locale, "matches.searchLabel"]" />

    @* THERE IS NO CONFEDERATION FILTER, AND THAT IS DELIBERATE.
       The schedule this app reads has eight columns — match, date, two clocks,
       matchup, group/phase, venue, city — and confederation is not among them.
       Building the filter would mean inventing a team-to-confederation lookup
       and shipping it as though the schedule had supplied it, which is the same
       category of mocked data as TimeZoneLabel and a larger one: there are 48
       teams, and a wrong entry would be invisible. It stays unbuilt until data
       for it is authorized. *@
    <div class="matches__filters">
        <div class="matches__filter">
            <label for="matches-group">@L[Locale, "matches.groupLabel"]</label>
            <select id="matches-group" class="form-select" value="@groupSelection" @onchange="OnGroupChanged">
                <option value="@FixtureQuery.AllGroups">@L[Locale, "matches.allGroups"]</option>
                @foreach (var letter in GroupLetters)
                {
                    <option value="@letter">@L.Format(Locale, "phase.group", ("letter", letter))</option>
                }
                <option value="@FixtureQuery.KnockoutRounds">@L[Locale, "matches.knockoutRounds"]</option>
            </select>
        </div>

        <div class="matches__filter">
            <label for="matches-status">@L[Locale, "matches.statusLabel"]</label>
            <select id="matches-status" class="form-select" value="@statusFilter" @onchange="OnStatusChanged">
                <option value="@MatchStatusFilter.All">@L[Locale, "matches.allMatches"]</option>
                <option value="@MatchStatusFilter.Played">@L[Locale, "matches.played"]</option>
                <option value="@MatchStatusFilter.NotYetPlayed">@L[Locale, "matches.notYetPlayed"]</option>
            </select>
        </div>

        <div class="matches__filter">
            <label for="matches-availability">@L[Locale, "matches.availabilityLabel"]</label>
            <select id="matches-availability" class="form-select" value="@availabilityFilter" @onchange="OnAvailabilityChanged">
                <option value="@SlotAvailabilityFilter.All">@L[Locale, "matches.allAvailability"]</option>
                <option value="@SlotAvailabilityFilter.WithSlotsAvailable">@L[Locale, "matches.withSlots"]</option>
            </select>
        </div>
    </div>

    @if (!loaded)
    {
        <p class="matches__loading">@L[Locale, "matches.loading"]</p>
    }
    else if (FilteredFixtures.Count == 0)
    {
        <p class="matches__empty">@EmptyStateMessage</p>
    }
    else
    {
        @* Bootstrap's existing grid, at the one breakpoint this app already
           has. Fixtures have no inherent reading order between them, so a
           multi-column layout costs nothing here — unlike the access record,
           which is sequential and stays a single column. *@
        <div class="row">
            @foreach (var fixture in VisibleFixtures)
            {
                <div class="col-12 col-md-6" @key="fixture.MatchNumber">
                    <div class="matches__item">
                        @* The gate is computed here and handed down as a plain
                           bool. MatchCard is deliberately unable to work it out
                           for itself — see its own note. *@
                        <MatchCard MatchNumber="fixture.MatchNumber"
                                   Name="@FixtureLabels.Display(L, Locale, fixture)"
                                   Kickoff="fixture.KickoffLocal"
                                   TimeZoneLabel="@fixture.TimeZoneLabel"
                                   Venue="@fixture.Venue"
                                   City="@fixture.City"
                                   Phase="@FixtureLabels.Phase(L, Locale, fixture)"
                                   IsPlayed="fixture.IsResolved"
                                   SlotsRemaining="fixture.SlotsRemaining"
                                   CanRequest="Session.IsSignedIn" />
                    </div>
                </div>
            }
        </div>
    }

    @if (loaded && FilteredFixtures.Count > 0)
    {
        @* The count is announced rather than only shown. Pressing "Show more"
           moves nothing that was already on screen and adds twelve rows below
           the fold, so a screen-reader user gets no notification at all unless
           the count says what just happened — which is the whole reason this
           line is polite rather than decorative. *@
        <p class="matches__count" aria-live="polite">
            @L.Format(Locale, "matches.showingCount",
                ("shown", VisibleFixtures.Count), ("total", FilteredFixtures.Count))
        </p>

        @if (VisibleFixtures.Count < FilteredFixtures.Count)
        {
            <button type="button" class="btn btn-outline-primary matches__show-more" @onclick="ShowMore">
                @L[Locale, "matches.showMore"]
            </button>
        }
    }
}

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }

    /// <summary>
    /// How many more fixtures each press reveals — and, since nothing is ever
    /// hidden again, how many are on screen to begin with.
    ///
    /// <para>
    /// Twelve rather than ShopEase's six, because that list holds twelve
    /// products and this one holds a hundred and four fixtures, and twelve is
    /// one row-pair at the existing col-md-6 breakpoint. Nine presses reach the
    /// end, which is deliberate friction: the intent is to make filtering more
    /// attractive than paging, and a show-all button would remove the reason to
    /// filter at all.
    /// </para>
    /// </summary>
    private const int PageSize = 12;

    private IReadOnlyList<Fixture> allFixtures = [];
    private string searchTerm = string.Empty;
    private string groupSelection = FixtureQuery.AllGroups;
    private MatchStatusFilter statusFilter = MatchStatusFilter.All;
    private SlotAvailabilityFilter availabilityFilter = SlotAvailabilityFilter.All;
    private int visibleCount = PageSize;
    private DateTime lastSyncedUtc;
    private bool loaded;
    private bool loadFailed;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var response = await Access.GetFixturesAsync();
            allFixtures = response.Value;
            lastSyncedUtc = response.LastSyncedUtc;
            loaded = true;

            // An empty schedule is not a tournament with no matches in it; it
            // is a load that did not work, and saying so is more useful than
            // rendering a blank list.
            loadFailed = allFixtures.Count == 0;
        }
        catch (Exception)
        {
            loadFailed = true;
            loaded = true;
        }
    }

    private async Task ReloadAsync()
    {
        loadFailed = false;
        loaded = false;
        await LoadAsync();
    }

    // The options offered are the groups this schedule actually contains, read
    // from the data on every render rather than written down here.
    private List<string> GroupLetters => FixtureQuery.GroupLetters(allFixtures);

    // The predicate itself now lives in FixtureQuery, unchanged. It moved out
    // so it can be tested without rendering this page — not because anything
    // about how it matches was reconsidered. The filters narrow what it
    // returns; they never alter what it matches.
    private List<Fixture> FilteredFixtures =>
        FixtureQuery.Apply(allFixtures, searchTerm, groupSelection, statusFilter, L, Locale, availabilityFilter);

    private List<Fixture> VisibleFixtures => FilteredFixtures.Take(visibleCount).ToList();

    private void ShowMore() => visibleCount += PageSize;

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        visibleCount = PageSize;
    }

    // Every control resets the visible count, for the same reason each used to
    // reset the page: a narrowed list that inherited an expanded count would
    // show everything it has and hide the control that says so, leaving no
    // sign that the list is complete.
    private void OnGroupChanged(ChangeEventArgs e)
    {
        groupSelection = e.Value?.ToString() ?? FixtureQuery.AllGroups;
        visibleCount = PageSize;
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        statusFilter = Enum.TryParse<MatchStatusFilter>(e.Value?.ToString(), out var parsed)
            ? parsed
            : MatchStatusFilter.All;
        visibleCount = PageSize;
    }

    private void OnAvailabilityChanged(ChangeEventArgs e)
    {
        availabilityFilter = Enum.TryParse<SlotAvailabilityFilter>(e.Value?.ToString(), out var parsed)
            ? parsed
            : SlotAvailabilityFilter.All;
        visibleCount = PageSize;
    }

    /// <summary>
    /// Which controls are currently narrowing the list, named as a reader would
    /// name them. Used only by the empty state.
    /// </summary>
    private List<string> ActiveControls
    {
        get
        {
            var active = new List<string>();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                active.Add(L.Format(Locale, "matches.controlSearch", ("term", searchTerm)));
            }

            if (groupSelection == FixtureQuery.KnockoutRounds)
            {
                active.Add(L[Locale, "matches.controlKnockout"]);
            }
            else if (groupSelection != FixtureQuery.AllGroups)
            {
                active.Add(L.Format(Locale, "matches.controlGroup", ("letter", groupSelection)));
            }

            if (statusFilter == MatchStatusFilter.Played)
            {
                active.Add(L[Locale, "matches.controlPlayed"]);
            }
            else if (statusFilter == MatchStatusFilter.NotYetPlayed)
            {
                active.Add(L[Locale, "matches.controlNotPlayed"]);
            }

            // The empty state enumerates what is narrowing the list, so a
            // control missing from here would leave a reader looking at an
            // empty screen with one of the reasons for it unnamed.
            if (availabilityFilter == SlotAvailabilityFilter.WithSlotsAvailable)
            {
                active.Add(L[Locale, "matches.controlWithSlots"]);
            }

            return active;
        }
    }

    // States what is narrowing the list and stops there. It does not guess why a
    // result set is empty beyond that — with the one exception below, which is
    // not a guess but a property of the data the reader cannot see.
    private string EmptyStateMessage
    {
        get
        {
            var active = ActiveControls;

            if (active.Count == 0)
            {
                return L[Locale, "matches.emptyNone"];
            }

            var message = L.Format(Locale, "matches.emptyNarrowed",
                ("controls", string.Join(", ", active)));

            // Kept wherever a team-name search could be the cause, because a
            // reader who typed a team name and got nothing has no other way of
            // knowing the app is withholding it rather than missing it.
            return string.IsNullOrWhiteSpace(searchTerm)
                ? message
                : message + " " + L[Locale, "matches.emptyWithholdingNote"];
        }
    }
}

@* The Router watches the browser's current address and picks a page to
   show. NotFoundPage names the fallback shown when no @page directive
   anywhere in the app matches the address at all — see Pages/NotFound.razor. *@
<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @* A match was found: render it inside the shared MainLayout frame. *@
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

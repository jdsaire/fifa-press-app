@implements IDisposable
@inject SimulatedSessionProvider Session
@inject LocaleService L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @* The product name, never translated: 11 §3's rule is that a name
           identifying the product stays English, while a name identifying what
           a person is looking at translates. *@
        <a class="navbar-brand" href="">@L[Locale, "app.name"]</a>
        <button title="@MenuTitle" class="navbar-toggler" @onclick="ToggleNavMenu"
                aria-expanded="@MenuExpanded" aria-controls="nav-menu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div id="nav-menu" class="@NavMenuCssClass nav-scrollable">
    @* DESTINATIONS, AND NOTHING ELSE. This list used to end in a tail of
       controls — language, theme, sign out — because those three had nowhere
       better to be: the list is the same element at both breakpoints, so a row
       added to it collapsed on a phone for free. That was a housing decision,
       not a claim that a control belongs among sections, and the file said as
       much at the time. They have a home of their own now (Settings, and the
       session row above the content column), so the exception closes and the
       list is what it always said it should be.

       Sign in is still not among the destinations — it is a door, not a
       section. That row gated nothing when the line was written; it
       gates the record now, and the conditional row below says so by
       appearing only once there is a record to look at. *@
    <nav class="nav flex-column">
        @* The root, and the only row that needs a match override: an empty
           href prefix-matches every address in the app, so ordinary prefix
           matching would leave this row active everywhere. The row that used
           to carry the override did so as a workaround for pointing at the
           root while meaning the record; this one points at the root and means
           it. *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <Icon Name="home" />@L[Locale, "nav.home"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="matches">
                <Icon Name="matches" />@L[Locale, "nav.matches"]
            </NavLink>
        </div>
        @if (Session.IsSignedIn)
        {
            @* Conditional, and third rather than appended at the end: it is a
               destination like the ones around it, and a signed-in person's
               requests belong beside the matches those requests are for. A
               signed-out visitor sees exactly four rows, which is the set the
               dossier describes; the fifth appears only when there is
               something behind it. *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="record">
                    <Icon Name="record" />@L[Locale, "nav.record"]
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="help">
                <Icon Name="help" />@L[Locale, "nav.help"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <Icon Name="settings" />@L[Locale, "nav.settings"]
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // Pulled out of the attribute rather than inlined: a lookup with its own
    // quoted key inside a quoted attribute value is a parse the Razor
    // compiler should not have to be trusted with.
    private string MenuTitle => L[Locale, "nav.menu"];

    /// <summary>
    /// The literal word rather than a bool, for the same reason MenuTitle is a
    /// property: Blazor renders a bool attribute present-and-empty, so
    /// aria-expanded carried no value a screen reader could read.
    /// </summary>
    private string MenuExpanded => collapseNavMenu ? "false" : "true";

    protected override void OnInitialized() => Session.OnChanged += Refresh;

    public void Dispose() => Session.OnChanged -= Refresh;

    /// <summary>
    /// The session changes from a form this component does not own and cannot
    /// be told about directly. Subscribing is what keeps the conditional row
    /// from being a render behind the session it depends on.
    /// </summary>
    private void Refresh() => InvokeAsync(StateHasChanged);

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

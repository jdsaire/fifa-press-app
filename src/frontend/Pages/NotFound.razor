@* This page isn't reached via a nav link — App.razor's <Router> shows it
   automatically whenever the current address doesn't match any @page
   directive in the app at all. *@
@page "/not-found"
@layout MainLayout
@inject LocaleService L

<PageTitle>@L[Locale, "notFound.title"]</PageTitle>

<h1>@L[Locale, "notFound.title"]</h1>
<p>@L[Locale, "notFound.body"]</p>
<NavLink class="btn btn-primary btn-sm" href="">@L[Locale, "notFound.back"]</NavLink>

@code {
    [CascadingParameter]
    public AppLocale Locale { get; set; }
}

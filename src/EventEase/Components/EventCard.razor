@* Each field below shows its current value and an inline error message
   directly beneath it when invalid, instead of silently accepting bad input. *@
<div class="card event-card mb-3">
    <div class="card-body">
        <input class="form-control mb-1" value="@EventName" @oninput="OnNameInput" placeholder="Event name" />
        @if (nameError is not null)
        {
            <div class="text-danger small mb-2">@nameError</div>
        }

        <input type="date" class="form-control mb-1" value="@EventDate.ToString("yyyy-MM-dd")" @oninput="OnDateInput" />
        @if (dateError is not null)
        {
            <div class="text-danger small mb-2">@dateError</div>
        }

        <input class="form-control mb-1" value="@Location" @oninput="OnLocationInput" placeholder="Location" />
        @if (locationError is not null)
        {
            <div class="text-danger small">@locationError</div>
        }
    </div>
</div>

@code {
    // Each parameter is paired with a matching "...Changed" EventCallback.
    // That X / XChanged pairing is what lets a parent page write
    // @bind-EventName="ev.Name" and get two-way binding for free: the parent's
    // value flows in here, and calling EventNameChanged.InvokeAsync (below)
    // flows edits back out to the parent.
    [Parameter]
    public string EventName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> EventNameChanged { get; set; }

    [Parameter]
    public DateTime EventDate { get; set; }

    [Parameter]
    public EventCallback<DateTime> EventDateChanged { get; set; }

    [Parameter]
    public string Location { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> LocationChanged { get; set; }

    private string? nameError;
    private string? dateError;
    private string? locationError;

    // Blazor calls OnParametersSet automatically whenever this component
    // receives new parameter values — both when it first appears and every
    // time the parent's data changes. Re-validating here (not just in the
    // input handlers below) means the error state is always in sync with
    // whatever value the component actually has, not just what was typed.
    protected override void OnParametersSet()
    {
        nameError = string.IsNullOrWhiteSpace(EventName) ? "Event name is required." : null;
        dateError = EventDate == default ? "A valid date is required." : null;
        locationError = string.IsNullOrWhiteSpace(Location) ? "Location is required." : null;
    }

    // The three handlers below share one pattern: re-check validity, update
    // the local value, then invoke the matching "...Changed" callback so the
    // parent page's own copy of the data updates too.
    private async Task OnNameInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        nameError = string.IsNullOrWhiteSpace(value) ? "Event name is required." : null;
        EventName = value;
        await EventNameChanged.InvokeAsync(EventName);
    }

    private async Task OnDateInput(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsed))
        {
            dateError = null;
            EventDate = parsed;
            await EventDateChanged.InvokeAsync(EventDate);
        }
        else
        {
            dateError = "A valid date is required.";
        }
    }

    private async Task OnLocationInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        locationError = string.IsNullOrWhiteSpace(value) ? "Location is required." : null;
        Location = value;
        await LocationChanged.InvokeAsync(Location);
    }
}

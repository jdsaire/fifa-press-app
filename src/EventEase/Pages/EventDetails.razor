@* {Id:int} is a route parameter: whatever number appears in that spot of
   the actual address (e.g. /events/3) is captured into the Id property
   below, constrained to integers only. *@
@page "/events/{Id:int}"
@using EventEase.Models
@using EventEase.Services
@inject SessionTracker Session
@inject AttendanceTracker Attendance

<PageTitle>@PageHeading</PageTitle>

<nav aria-label="breadcrumb" class="mb-2">
    <NavLink href="">Events</NavLink> <span aria-hidden="true">/</span> <span>@PageHeading</span>
</nav>

<h1>@PageHeading</h1>

@if (selectedEvent is not null)
{
    <EventCard @bind-EventName="selectedEvent.Name" @bind-EventDate="selectedEvent.Date" @bind-Location="selectedEvent.Location" ReadOnly="true" />
    @if (Session.IsRegistered(selectedEvent.Id))
    {
        <span class="badge bg-success me-2">Registered</span>
    }
    <p class="text-muted">@Attendance.GetAttendeeCount(selectedEvent.Id) people registered</p>
    <NavLink class="btn btn-primary btn-sm me-2" href="@($"register/{selectedEvent.Id}")">Register</NavLink>
}
else
{
    @* Reached when the address shape matches (e.g. /events/9999) but no
       event in the mock data has that ID — the router alone can't catch
       this, since as far as routing is concerned the address is valid. *@
    <p class="text-danger">No event matches this ID. It may have been removed.</p>
}

<NavLink class="btn btn-outline-secondary btn-sm mt-3" href="">Back to events</NavLink>

@code {
    [Parameter]
    public int Id { get; set; }

    private EventModel? selectedEvent;

    private string PageHeading => selectedEvent?.Name ?? "Event Details";

    protected override void OnParametersSet()
    {
        selectedEvent = MockEventData.GetSampleEvents().FirstOrDefault(e => e.Id == Id);
    }
}

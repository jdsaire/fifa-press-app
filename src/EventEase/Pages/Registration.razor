@page "/register/{Id:int}"
@using EventEase.Models
@using EventEase.Services
@inject SessionTracker Session
@inject AttendanceTracker Attendance

<PageTitle>Register</PageTitle>

<h1>Register for Event</h1>

@if (selectedEvent is not null)
{
    <p>You're registering for:</p>
    <EventCard @bind-EventName="selectedEvent.Name" @bind-EventDate="selectedEvent.Date" @bind-Location="selectedEvent.Location" />

    @if (Session.IsRegistered(Id))
    {
        <p class="text-success">You're registered for @selectedEvent.Name!</p>
    }
    else
    {
        <EditForm Model="registration" OnValidSubmit="HandleValidSubmit" class="mt-3">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-2">
                <label>Name</label>
                <InputText class="form-control" @bind-Value="registration.Name" />
            </div>
            <div class="mb-2">
                <label>Email</label>
                <InputText class="form-control" @bind-Value="registration.Email" />
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
        </EditForm>
    }
}
else
{
    <p class="text-danger">No event matches this ID. It may have been removed.</p>
}

<NavLink class="btn btn-outline-secondary btn-sm mt-3" href="/">Back to events</NavLink>

@code {
    [Parameter]
    public int Id { get; set; }

    private EventModel? selectedEvent;
    private RegistrationModel registration = new();

    protected override void OnParametersSet()
    {
        selectedEvent = MockEventData.GetSampleEvents().FirstOrDefault(e => e.Id == Id);
    }

    private void HandleValidSubmit()
    {
        Session.Register(Id);
        Attendance.RegisterAttendee(Id, registration.Name, registration.Email);
    }
}

@* Same {Id:int} route-parameter pattern as EventDetails.razor — this page
   is reachable at /register/3, /register/7, and so on. *@
@page "/register/{Id:int}"
@using EventEase.Models
@using EventEase.Services
@inject SessionTracker Session
@inject AttendanceTracker Attendance

<PageTitle>Register</PageTitle>

<h1>Register for Event</h1>

@if (selectedEvent is not null)
{
    <p>You're registering for:</p>
    <EventCard @bind-EventName="selectedEvent.Name" @bind-EventDate="selectedEvent.Date" @bind-Location="selectedEvent.Location" ReadOnly="true" />

    @if (Session.IsRegistered(Id))
    {
        <p class="text-success" role="status" tabindex="-1" @ref="confirmationRef">You're registered for @selectedEvent.Name!</p>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="HandleCancel">Cancel registration</button>
    }
    else
    {
        @* OnValidSubmit (not a plain submit handler) only fires once
           DataAnnotationsValidator confirms every rule on RegistrationModel
           passed — an invalid form never reaches HandleValidSubmit below. *@
        <EditForm Model="registration" OnValidSubmit="HandleValidSubmit" class="mt-3">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-2">
                <label for="registration-name">Name</label>
                <InputText id="registration-name" class="form-control" @bind-Value="registration.Name" />
            </div>
            <div class="mb-2">
                <label for="registration-email">Email</label>
                <InputText id="registration-email" class="form-control" @bind-Value="registration.Email" />
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
        </EditForm>
    }
}
else
{
    <p class="text-danger">No event matches this ID. It may have been removed.</p>
}

<NavLink class="btn btn-outline-secondary btn-sm mt-3" href="">Back to events</NavLink>

@code {
    [Parameter]
    public int Id { get; set; }

    private EventModel? selectedEvent;
    private RegistrationModel registration = new();
    private ElementReference confirmationRef;
    private bool shouldFocusConfirmation;

    protected override void OnParametersSet()
    {
        selectedEvent = MockEventData.GetSampleEvents().FirstOrDefault(e => e.Id == Id);
    }

    // Two independent services updated from one successful submit:
    // SessionTracker (per-user — "did I sign up?") and AttendanceTracker
    // (per-event — "who's coming?"). Deliberately kept separate; see
    // Services/README.md and learning-mode/03 for why.
    private void HandleValidSubmit()
    {
        Session.Register(Id, registration.Name, registration.Email);
        Attendance.RegisterAttendee(Id, registration.Name, registration.Email);
        shouldFocusConfirmation = true;
    }

    // Undoes HandleValidSubmit: removes the same attendee entry that was
    // added at registration time, then clears the per-session flag, so
    // SessionTracker and AttendanceTracker never disagree about who's in.
    private void HandleCancel()
    {
        var existingRegistration = Session.GetRegistration(Id);
        if (existingRegistration is not null)
        {
            Attendance.RemoveAttendee(Id, existingRegistration.Value.Name, existingRegistration.Value.Email);
        }

        Session.Unregister(Id);
    }

    // Moves focus to the confirmation message right after it renders, so a
    // keyboard/screen-reader user's focus follows the form that just
    // disappeared instead of landing nowhere. role="status" above means the
    // same message is also announced to assistive technology as a live
    // region, independent of focus.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusConfirmation)
        {
            shouldFocusConfirmation = false;
            await confirmationRef.FocusAsync();
        }
    }
}

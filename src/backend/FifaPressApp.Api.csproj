<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FifaPressApp.Api</RootNamespace>
  </PropertyGroup>

  <!-- One package, and it is the Web API template's own default: the OpenAPI
       document generator. It is registered bare — AddOpenApi() and MapOpenApi()
       with no customisation — so the API can describe its own surface to a
       reader without anybody having to open the code. Nothing else is added
       here: no ORM, no authentication library, no mapping or validation
       package. Everything this API does beyond the framework, it does in its
       own files, on purpose.

       Pinned at 10.0.11 rather than 10.0.5, which is the version the frontend's
       packages sit at. 10.0.5 resolves Microsoft.OpenApi 2.0.0 transitively, and
       that version carries a known high-severity advisory (GHSA-v5pm-xwqc-g5wc).
       10.0.11 resolves 2.7.5, which does not. A public repository should not ship
       a flagged dependency to make two version numbers match. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <!-- The two demo records and their eight changes, copied beside the binary
       so the store can read them at startup. The same data the frontend's mock
       has always held, so the before/after comparison is like-for-like. -->
  <ItemGroup>
    <Content Update="Data/seed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
